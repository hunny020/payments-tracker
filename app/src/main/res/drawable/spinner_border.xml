<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Main background with black border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <stroke android:width="2dp" android:color="@android:color/black" />
            <corners android:radius="6dp" />
        </shape>
    </item>

    <!-- dropdown arrow area on the right -->
    <item android:right="0dp" android:left="187dp"> <!-- 223dp total width - 36dp right area -->
        <shape android:shape="rectangle">
            <solid android:color="@color/dropdown_grey" />
            <stroke android:width="2dp" android:color="@android:color/black" />
            <corners
                android:topRightRadius="6dp"
                android:bottomRightRadius="6dp" />
        </shape>
    </item>

    <item android:gravity="right|center_vertical" android:right="10dp">
        <bitmap
            android:src="@android:drawable/arrow_down_float"
            android:tint="@color/black"
            android:gravity="center" />
    </item>

</layer-list>